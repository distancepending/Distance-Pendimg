{
  "name": "distance-pending",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "distancepending.com",
      "custom_domain": true
    },
    {
      "pattern": "www.distancepending.com",
      "custom_domain": true
    }
  ]
}
